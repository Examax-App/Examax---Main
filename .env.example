# Copy to .env.local and fill in. Never commit real values: .env.local is
# git-ignored, and Vercel holds the deployed ones (Project → Settings →
# Environment Variables). NEXT_PUBLIC_ values are built into the browser
# bundle and are public by design; everything else is server-only.

# ─── Supabase (Project Settings → API Keys) ───────────────────────────────
# The project's API URL. Public.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_…). Public: Row Level Security decides
# what it can read or write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The secret key (sb_secret_…). Bypasses Row Level Security; used only to
# delete accounts (lib/supabase/admin.ts). Server-only.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Cloudflare Turnstile (Cloudflare → Turnstile → the widget) ───────────
# The site key renders the widget on the auth forms. Public. The secret lives
# only in Supabase, which verifies every token: Authentication → Attack
# Protection → CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ─── Google sign-in (Google Cloud → Google Auth Platform → Clients) ───────
# The same OAuth client as Supabase's Google provider. Our server runs the
# Google step itself so Google's screen names examax.app, not supabase.co
# (lib/auth/google.ts). Its Authorized redirect URIs must list
# http://localhost:3000/auth/google/callback and
# https://examax.app/auth/google/callback. The secret is server-only.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# "true" sends the Google button through /auth/google. Leave it off until the
# redirect URIs above are saved in Google Cloud; off, Google signs in through
# Supabase (its screen then names the Supabase project).
GOOGLE_SIGN_IN_VIA_SITE=false

# Microsoft sign-in needs no variables here: its client ID and secret live in
# Supabase (Authentication → Sign In / Providers → Azure).

# ─── Email (Resend) ───────────────────────────────────────────────────────
# The contact forms (app/api/contact). Auth e-mails go through Supabase's
# own SMTP settings, not this key.
RESEND_API_KEY=re_...
SUPPORT_FROM="Examax Pomoc <pomoc@examax.app>"
CONTACT_FROM="Examax Kontakt <kontakt@examax.app>"
INSTITUTIONS_FROM="Examax Instytucje <instytucje@examax.app>"
REPORT_FROM="Examax Zgłoszenia <report@examax.app>"
SUPPORT_INBOX=pomoc@examax.app
CONTACT_INBOX=kontakt@examax.app
INSTITUTIONS_INBOX=instytucje@examax.app
REPORT_INBOX=problem@examax.app

# ─── Stripe (not used by the app yet) ─────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Server-only.
STRIPE_SECRET_KEY=rk_live_...

# ─── Sanity (public by design; the code falls back to these values) ───────
NEXT_PUBLIC_SANITY_PROJECT_ID=64k3ozib
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer-role read token for Draft Mode. Server-only.
SANITY_API_READ_TOKEN=sk...
