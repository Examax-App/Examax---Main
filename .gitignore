# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# credentials that must never be committed
*.key
*.p12
*.pfx
*service-account*.json
/supabase/.temp/
/supabase/.branches/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: none is ever committed (.env.local holds the real values);
# .env.example lists the names with placeholders only
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# remotion: the film's synthesised audio (regenerate with `pnpm film:audio`)
/remotion/public/film/

# local tooling
/.claude/settings.local.json
/.claude/worktrees/
/.claude/.cc-writes
.idea/
.vscode/*
!.vscode/extensions.json

# Private
/DesignRules/